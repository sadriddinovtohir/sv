TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google Analytics measurement ID (optional)
VITE_GA_ID=G-XXXXXXX

# Public site address, no trailing slash — used for canonical/og:url and sitemap.xml
VITE_SITE_URL=https://your-domain.vercel.app

# GitHub & GitLab section (all optional, server-side only — never sent to the browser).
# Without tokens only public repo counts are shown; with the owner's tokens the
# section shows public / private / total. Only counts are exposed, never repo names.
# GitHub: classic token with "repo" scope, or fine-grained (all repos, Metadata: read-only)
GITHUB_TOKEN=
# GitLab: personal access token with "read_api" scope
GITLAB_TOKEN=
# Defaults to sadriddinovtohir for both
GITHUB_USERNAME=
GITLAB_USERNAME=
